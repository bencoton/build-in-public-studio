# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — these secrets stay on your machine.
# In Vercel they live in the project's Environment Variables panel.

# ── Neon Postgres ──────────────────────────────────────────────────────────
# Pooled connection string from the Neon dashboard. The host MUST contain
# `-pooler.` — Vercel serverless and Next.js dev both rely on the pooler.
DATABASE_URL=postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Anthropic ──────────────────────────────────────────────────────────────
# https://console.anthropic.com/ → Get API Keys → Create Key
ANTHROPIC_API_KEY=

# ── GitHub ─────────────────────────────────────────────────────────────────
# https://github.com/settings/tokens?type=beta (fine-grained PAT)
# Repository access: only the repos you want this app to watch.
# Contents: Read-only. Everything else: No access.
GITHUB_TOKEN=

# ── Vercel Cron ────────────────────────────────────────────────────────────
# Shared secret between Vercel Cron and the /api/cron/generate route. Vercel
# automatically sends `Authorization: Bearer ${CRON_SECRET}` on cron requests
# when this env var is set. Without it, the cron endpoint becomes a public
# unauthenticated trigger for a paid Claude call.
#
# Generate a random one (PowerShell):
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 48 | % { [char]$_ })
#
# Then add the SAME value to Vercel: Settings → Environment Variables →
# Production + Preview + Development, marked as "Sensitive".
CRON_SECRET=
