# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — these secrets stay on your machine.

# Anthropic API key (Stage 3). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# GitHub Personal Access Token (Stage 3). Create at:
# https://github.com/settings/tokens?type=beta  (fine-grained, read-only on repos you want to watch)
GITHUB_TOKEN=
