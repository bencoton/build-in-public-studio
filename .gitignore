# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Office temp/lock files (e.g. opening a .md in Word creates ~$… lockfiles)
~$*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local SQLite database (notes, drafts, etc. — your data, never commit it)
/data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# migration backups — schema/data dumps may contain personal info, never commit
migration-backups/

# Cowork session config — local-only.
.claude/

# WyCo-standard reference docs — kept locally for my own reference but not
# committed to the public repo. Canonical copies live in
# C:\Users\benco\code\Ways of Working\
docs/Ways-of-Working.md
docs/WYCO-DIGITAL-STYLE-GUIDE.md
docs/Tech-Stack.md

.vercel
.env*
